# Copy to `.env` and fill in values. Never commit `.env`.

# HTTP port (must match phind-ai NEXT_PUBLIC_API_URL port)
PORT=3001

# OpenAI (required for POST /chat, /chat/rag, embeddings)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google OAuth (Drive + Docs ingestion). Create OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI in the OAuth client (backend receives the code).
GOOGLE_REDIRECT_URI=http://localhost:3001/ingestion/auth/callback

# After token exchange, Nest redirects the browser here (Next.js app + /auth/callback).
FRONTEND_URL=http://localhost:3000

# Optional: where to save OAuth access/refresh tokens between API restarts (default: ./data/google-oauth.json).
# GOOGLE_OAUTH_TOKEN_PATH=

# Optional: comma-separated browser origins when you do NOT want open CORS (production).
# Example: https://app.example.com,http://localhost:3000
# If unset, Nest uses reflected Origin with credentials (fine for local dev).
# CORS_ORIGINS=
