{
  "info": {
    "name": "AI Document Chat API",
    "description": "Backend for AI Document Chat (NestJS).\n\n**Typical flow:** OAuth -> ingest documents -> POST .../process (index chunks) -> POST /chat/rag.\n\n**Swagger:** GET {{baseUrl}}/api\n\n**Frontend contract:** see repo `docs/API_FRONTEND_NOTES.md`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "googleDocId",
      "value": "YOUR_GOOGLE_FILE_ID",
      "type": "string"
    },
    {
      "key": "canonicalDocumentId",
      "value": "google_docs_YOUR_GOOGLE_FILE_ID",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Health checks. GET /health may return extra fields depending on which handler is registered.",
      "item": [
        {
          "name": "Basic Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Returns at least status + ISO timestamp."
          }
        },
        {
          "name": "Liveness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/live",
            "description": "Kubernetes liveness."
          }
        },
        {
          "name": "Readiness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/ready",
            "description": "Readiness; may be degraded if Google is not authenticated."
          }
        },
        {
          "name": "Detailed Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/status",
            "description": "Memory, uptime, ingested document count, Google auth flag."
          }
        }
      ]
    },
    {
      "name": "Chat",
      "description": "POST /chat = plain OpenAI. POST /chat/rag = retrieval from indexed documents (run ingestion process first).",
      "item": [
        {
          "name": "Send Chat Message (no RAG)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Hello, how are you?\"\n}"
            },
            "url": "{{baseUrl}}/chat",
            "description": "Required: message. Optional: messages[] for prior turns."
          }
        },
        {
          "name": "Chat with History (no RAG)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What did I just ask you?\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Hello, how are you?\" },\n    { \"role\": \"assistant\", \"content\": \"I'm doing well. How can I help?\" }\n  ]\n}"
            },
            "url": "{{baseUrl}}/chat",
            "description": "Server appends `message` as the latest user turn."
          }
        },
        {
          "name": "RAG Chat (minimal)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What is this document about?\"\n}"
            },
            "url": "{{baseUrl}}/chat/rag",
            "description": "Requires chunks in the vector store. Response includes `sources` and `usage`."
          }
        },
        {
          "name": "RAG Chat (topK, minScore, documentIds)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"List the main risks mentioned.\",\n  \"topK\": 5,\n  \"minScore\": 0.15,\n  \"documentIds\": [\"{{canonicalDocumentId}}\"]\n}"
            },
            "url": "{{baseUrl}}/chat/rag",
            "description": "Optional filters: only search listed canonical document IDs."
          }
        },
        {
          "name": "RAG Chat with prior turns",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Can you shorten that to one bullet?\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"What are the deadlines?\" },\n    { \"role\": \"assistant\", \"content\": \"The document sets Q2 for release.\" }\n  ]\n}"
            },
            "url": "{{baseUrl}}/chat/rag",
            "description": "`message` is the current question; `messages` are prior user/assistant turns."
          }
        }
      ]
    },
    {
      "name": "Ingestion - Auth",
      "description": "Google OAuth for the backend connector.",
      "item": [
        {
          "name": "1. Get OAuth URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ingestion/auth/url",
            "description": "Returns { url }. Open in browser to sign in."
          }
        },
        {
          "name": "2. OAuth Callback",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ingestion/auth/callback?code=YOUR_AUTH_CODE",
            "description": "Exchange code for tokens (usually hit by redirect, not manually)."
          }
        },
        {
          "name": "3. Check Auth Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ingestion/auth/status",
            "description": "{ authenticated: boolean }"
          }
        }
      ]
    },
    {
      "name": "Ingestion - Documents",
      "description": "Ingest uses Google file IDs; listed docs use canonical ids (google_docs_...).",
      "item": [
        {
          "name": "List Available Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ingestion/documents/available",
            "description": "Drive listing; requires Google auth."
          }
        },
        {
          "name": "Ingest Single Document",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/ingestion/documents/{{googleDocId}}/ingest",
            "description": "Path id = Google file ID (not canonical prefix)."
          }
        },
        {
          "name": "Ingest Batch (Selected Documents)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentIds\": [\n    \"{{googleDocId}}\"\n  ]\n}"
            },
            "url": "{{baseUrl}}/ingestion/documents/batch",
            "description": "Body: Google file IDs from available list."
          }
        },
        {
          "name": "Get All Ingested Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ingestion/documents",
            "description": "Summary list; use `id` for process and RAG documentIds."
          }
        },
        {
          "name": "Get Single Ingested Document",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ingestion/documents/{{canonicalDocumentId}}",
            "description": "Full canonical document; path id includes google_docs_ prefix."
          }
        }
      ]
    },
    {
      "name": "Ingestion - RAG (indexing)",
      "description": "Chunk + embed + store. Required before POST /chat/rag returns useful results.",
      "item": [
        {
          "name": "Process Single Document (index for RAG)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/ingestion/documents/{{canonicalDocumentId}}/process",
            "description": "Path id = canonical id from GET /ingestion/documents. Returns chunksCreated, embeddingsGenerated."
          }
        },
        {
          "name": "Process All Ingested Documents",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/ingestion/documents/process-all",
            "description": "Indexes every ingested document."
          }
        },
        {
          "name": "RAG / Vector Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ingestion/rag/stats",
            "description": "Processing and vector store statistics."
          }
        }
      ]
    }
  ]
}
