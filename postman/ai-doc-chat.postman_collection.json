{
  "info": {
    "name": "AI Document Chat API",
    "description": "Complete API collection for the AI Document Chat backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Health check endpoints (Google Cloud best practices)",
      "item": [
        {
          "name": "Basic Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Basic health check - returns OK if server is running"
          }
        },
        {
          "name": "Liveness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": ["{{baseUrl}}"],
              "path": ["health", "live"]
            },
            "description": "Kubernetes liveness probe - checks if app is alive"
          }
        },
        {
          "name": "Readiness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": ["{{baseUrl}}"],
              "path": ["health", "ready"]
            },
            "description": "Kubernetes readiness probe - checks if app can serve traffic"
          }
        },
        {
          "name": "Detailed Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/status",
              "host": ["{{baseUrl}}"],
              "path": ["health", "status"]
            },
            "description": "Detailed service status including memory, uptime, and document count"
          }
        }
      ]
    },
    {
      "name": "Chat",
      "description": "OpenAI chat endpoints",
      "item": [
        {
          "name": "Send Chat Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Hello, how are you?\",\n  \"messages\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat",
              "host": ["{{baseUrl}}"],
              "path": ["chat"]
            },
            "description": "Send a message to OpenAI and get a response"
          }
        },
        {
          "name": "Chat with History",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What did I just ask you?\",\n  \"messages\": [\n    {\"role\": \"user\", \"content\": \"Hello, how are you?\"},\n    {\"role\": \"assistant\", \"content\": \"I'm doing well, thank you for asking! How can I help you today?\"}\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat",
              "host": ["{{baseUrl}}"],
              "path": ["chat"]
            },
            "description": "Send a message with conversation history for context"
          }
        }
      ]
    },
    {
      "name": "Ingestion - Auth",
      "description": "Google OAuth authentication endpoints",
      "item": [
        {
          "name": "1. Get OAuth URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ingestion/auth/url",
              "host": ["{{baseUrl}}"],
              "path": ["ingestion", "auth", "url"]
            },
            "description": "Get the Google OAuth authorization URL. Open this URL in browser to authenticate."
          }
        },
        {
          "name": "2. OAuth Callback",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ingestion/auth/callback?code=YOUR_AUTH_CODE",
              "host": ["{{baseUrl}}"],
              "path": ["ingestion", "auth", "callback"],
              "query": [
                {
                  "key": "code",
                  "value": "YOUR_AUTH_CODE",
                  "description": "Replace with the authorization code from Google OAuth redirect"
                }
              ]
            },
            "description": "Exchange the OAuth authorization code for access tokens"
          }
        },
        {
          "name": "3. Check Auth Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ingestion/auth/status",
              "host": ["{{baseUrl}}"],
              "path": ["ingestion", "auth", "status"]
            },
            "description": "Check if the server is authenticated with Google"
          }
        }
      ]
    },
    {
      "name": "Ingestion - Documents",
      "description": "Document listing and ingestion endpoints",
      "item": [
        {
          "name": "List Available Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ingestion/documents/available",
              "host": ["{{baseUrl}}"],
              "path": ["ingestion", "documents", "available"]
            },
            "description": "List all Google Docs available in the user's Drive. Requires authentication."
          }
        },
        {
          "name": "Ingest Single Document",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ingestion/documents/:documentId/ingest",
              "host": ["{{baseUrl}}"],
              "path": ["ingestion", "documents", ":documentId", "ingest"],
              "variable": [
                {
                  "key": "documentId",
                  "value": "YOUR_DOCUMENT_ID",
                  "description": "Google Doc ID from the available documents list"
                }
              ]
            },
            "description": "Ingest a single document by its Google Doc ID"
          }
        },
        {
          "name": "Ingest Batch (Selected Documents)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentIds\": [\n    \"document_id_1\",\n    \"document_id_2\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ingestion/documents/batch",
              "host": ["{{baseUrl}}"],
              "path": ["ingestion", "documents", "batch"]
            },
            "description": "Ingest multiple selected documents"
          }
        },
        {
          "name": "Get All Ingested Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ingestion/documents",
              "host": ["{{baseUrl}}"],
              "path": ["ingestion", "documents"]
            },
            "description": "Get a list of all documents that have been ingested"
          }
        },
        {
          "name": "Get Single Ingested Document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ingestion/documents/:documentId",
              "host": ["{{baseUrl}}"],
              "path": ["ingestion", "documents", ":documentId"],
              "variable": [
                {
                  "key": "documentId",
                  "value": "google_docs_YOUR_DOCUMENT_ID",
                  "description": "Full document ID (includes google_docs_ prefix)"
                }
              ]
            },
            "description": "Get full details of a single ingested document including all content blocks"
          }
        }
      ]
    }
  ]
}
